#  Abyssal Arsenal: EAP-TLS (certificate-based 802.1X) and PEAP/MSCHAPv2
#  against Active Directory. Replaces the stock eap module. TTLS, MD5 and
#  GTC are left out: there's no password store to check them against.
#
#  PEAP logins are checked in sites-enabled/abyssal-inner (mschap module,
#  ntlm_auth through winbindd), and only succeed when the container is
#  joined to a domain (AD_REALM; README "PEAP against Active Directory").
#  Without it they're rejected, and EAP-TLS is unaffected.
#
#  Certificates (deploy/freeradius/certs, mounted read-only at
#  /etc/freeradius/certs-abyssal; see deploy/freeradius/README.md):
#    server.pem  this RADIUS server's certificate (with any intermediates)
#    server.key  its private key (unencrypted, readable by uid 101)
#    ca.pem      the CA(s) that issue the *client* certificates to accept
#
#  Any client certificate chaining to ca.pem is accepted at the EAP layer;
#  Panopticon then decides the device's VLAN, quarantine or reject by its
#  MAC (post-auth), exactly as for MAB. PEAP clients check server.pem too,
#  so it must chain to a CA they trust.

eap {
	default_eap_type = tls
	timer_expire = 60
	ignore_unknown_eap_types = no
	cisco_accounting_username_bug = no
	max_sessions = ${max_requests}

	tls-config tls-common {
		private_key_file = /etc/freeradius/certs-abyssal/server.key
		certificate_file = /etc/freeradius/certs-abyssal/server.pem
		ca_file = /etc/freeradius/certs-abyssal/ca.pem
		ca_path = /etc/freeradius/certs-abyssal
		cipher_list = "DEFAULT"
		cipher_server_preference = yes
		tls_min_version = "1.2"
		tls_max_version = "1.2"
		ecdh_curve = ""
		check_crl = no

		cache {
			enable = no
		}

		verify {
		}

		ocsp {
			enable = no
		}
	}

	tls {
		tls = tls-common
	}

	peap {
		tls = tls-common
		default_eap_type = mschapv2
		copy_request_to_tunnel = no
		use_tunneled_reply = no
		virtual_server = "abyssal-inner"
	}

	mschapv2 {
		send_error = no
	}
}
