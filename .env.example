# Copy to .env and fill in real values (or run ./install.sh, which does this
# for you with generated secrets). Never commit the real .env.

# ---- DATABASE ----
# MARIADB_* are what docker-compose.yml passes to the mariadb service and
# composes into the app's DATABASE_URL for you -- you shouldn't need to touch
# DATABASE_URL directly for the Docker path. It's here mainly for running the
# binary directly (`cargo run -p abyssal-arsenal`) against a local MariaDB.
# DB_PORT is the host-facing port docker-compose maps to the container
# (which always listens on 3306 internally) -- change this if 3306 is
# already taken by another MySQL/MariaDB instance on this machine. Update
# the port in DATABASE_URL below to match if you change it.
MARIADB_ROOT_PASSWORD=changeme-root
MARIADB_DATABASE=abyssal_arsenal
MARIADB_USER=abyssal
MARIADB_PASSWORD=changeme
DB_PORT=3306
DATABASE_URL=mysql://abyssal:changeme@127.0.0.1:3306/abyssal_arsenal

# ---- ADMIN / INITIAL SETUP ----
# There is no admin password here on purpose: the first administrator
# account is always created through the /setup wizard on first run, never
# seeded from configuration.

# ---- AUTHENTICATION ----
SESSION_COOKIE_NAME=abyssal_session
SESSION_TTL_HOURS=12

# ---- SESSION SECURITY ----
# Keep this on for any real deployment. Only turn it off for local plain-HTTP
# development, since the browser will refuse to send a Secure cookie without
# TLS -- and the /ws/agent WebSocket used by managed hosts follows the same
# scheme (wss:// vs ws://), so agents on a real deployment need TLS too.
COOKIE_SECURE=true

# ---- PUBLIC REGISTRATION ----
# Not configured here -- it's a runtime toggle in /admin/settings, disabled
# by default the moment the first administrator account is created.

# ---- SMTP ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ---- PUBLIC URL ----
# Base URL this control plane is reachable at (e.g.
# https://arsenal.example.com, no trailing slash needed either way). Used
# only to build a clickable link in outgoing emails -- currently just the
# "forgot password" reset email, which still works without this set (the
# email includes the raw reset token for the recipient to paste in
# instead), just with a slightly worse link-free experience. Deliberately
# not inferred from a request's Host header, since that's attacker-
# controllable and this is a security-sensitive link.
PUBLIC_URL=

# ---- NOTIFICATION PROVIDERS ----
# Additional providers (Telegram, Slack, Teams, Discord, ...) are a future
# addition to the notifications crate; only SMTP exists today.

# ---- SSO ----
# Reserved for a future OIDC/SAML provider. Local authentication is the only
# supported method in this release.

# ---- LOGGING ----
RUST_LOG=info

# ---- SERVER ----
# HTTP_PORT is the host-facing port docker-compose maps to the container
# (which always listens on 8080 internally) -- change this if 8080 is
# already taken on this machine. PORT/STATIC_DIR below only matter when
# running the binary directly outside Docker.
HTTP_PORT=8080
PORT=8080
STATIC_DIR=crates/web/static

# ---- REVERSE PROXY ----
# Set by ./install.sh; leave unset to run docker-compose without the
# optional Caddy service (profiles: ["caddy"] in docker-compose.yml).
COMPOSE_PROFILES=
